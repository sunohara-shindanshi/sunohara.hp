# =============================================================================
# 環境変数のサンプル
# 実際の値は .env.local（Git 管理対象外）に記述してください。
# このファイル自体には実値を書かないでください。
# =============================================================================

# -----------------------------------------------------------------------------
# microCMS（ブログ一覧の取得に使用 / すべてサーバー側でのみ使用する）
# ※ NEXT_PUBLIC_ を付けないこと（付けるとブラウザに露出します）
# -----------------------------------------------------------------------------

# microCMS のサービスドメイン。
# 管理画面 URL が https://your-service.microcms.io の場合、「your-service」の部分だけを設定します。
MICROCMS_SERVICE_DOMAIN=

# microCMS の API キー（管理画面「API キー」から取得。GET 権限があれば十分です）。
MICROCMS_API_KEY=

# ブログ記事 API のエンドポイント名（microCMS で作成した API の ID。設定仕様書の想定値は blogs）。
MICROCMS_BLOG_ENDPOINT=

# カテゴリ API のエンドポイント名（設定仕様書の想定値は categories）。
# 未設定でも記事一覧は表示できるが、カテゴリ絞り込みナビゲーションは表示されなくなる。
MICROCMS_CATEGORY_ENDPOINT=

# -----------------------------------------------------------------------------
# お問い合わせフォームのメール通知（Server Action から Resend で送信します）
# ※ すべてサーバー側でのみ使用。NEXT_PUBLIC_ を付けないこと。
# RESEND_API_KEY か CONTACT_FROM_EMAIL が未設定の場合、フォームは
# 「受け付けられない状態」というエラーを表示します（成功表示はしません）。
# -----------------------------------------------------------------------------

# Resend の API キー（https://resend.com で取得。秘匿値）。
RESEND_API_KEY=

# 送信元アドレス。Resend で「検証済みドメイン」のアドレスを指定します（例: noreply@あなたのドメイン）。
# 動作確認だけなら Resend のテスト用送信元 onboarding@resend.dev が使えます
# （テスト用はアカウント所有者のメール宛にのみ送信可能）。
CONTACT_FROM_EMAIL=

# 通知先（問い合わせ内容の届け先）アドレス。
# 未設定の場合は lib/siteConfig.ts の contactEmail（sunohara.shindanshi@gmail.com）に届きます。
# 宛先を変えたいときは、この 1 行を書き換えるだけで済みます。
CONTACT_TO_EMAIL=sunohara.shindanshi@gmail.com
